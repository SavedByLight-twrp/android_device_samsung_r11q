on init
    start qseecom-service

service qseecom-service /system/bin/vendor.qti.hardware.qseecom@1.0-service
    class hal
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    seclabel u:r:recovery:s0